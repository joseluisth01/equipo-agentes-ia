# Copia este archivo a .env.local (no se sube al repo) y en Vercel ponlas en Settings → Environment Variables.

# Base de datos Postgres gratuita (Neon o Supabase). Cadena de conexión completa.
DATABASE_URL=postgres://usuario:contraseña@host/db?sslmode=require

# Modelo de IA (plan gratuito). gemini → Google AI Studio · groq → console.groq.com
LLM_PROVIDER=gemini
LLM_API_KEY=
# Opcionales: sobrescriben el modelo/endpoint por defecto del proveedor
# LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=

# Usuario de prueba para entrar en la app (si no pones DEMO_PASSWORD, la app queda abierta)
DEMO_USER=evaluador
DEMO_PASSWORD=
# Secreto para firmar la cookie de sesión (cualquier cadena larga aleatoria)
AUTH_SECRET=
